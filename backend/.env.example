# ===========================================
# Expert Outreach System - Environment Variables
# ===========================================
# Copy this file to .env and fill in your API keys

# Apollo.io API (for candidate sourcing & enrichment)
APOLLO_API_KEY=your_apollo_api_key_here

# Anthropic Claude API (for LLM scoring, profiling & draft generation)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Exa AI API (for deep web research on experts — publications, talks, news)
EXA_API_KEY=your_exa_api_key_here

# Resend API (for sending emails)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=outreach@yourdomain.com
RESEND_FROM_NAME=Your Company Name

# ===========================================
# LinkedIn Automation (optional)
# ===========================================
# Session cookie from your LinkedIn browser session (li_at cookie value)
# LINKEDIN_SESSION_COOKIE=your_linkedin_li_at_cookie_here

# Daily rate limits to avoid LinkedIn restrictions
# LINKEDIN_DAILY_CONNECTION_LIMIT=50
# LINKEDIN_DAILY_MESSAGE_LIMIT=100

# ===========================================
# Optional Settings (defaults work for local dev)
# ===========================================

# Database (defaults to docker-compose postgres)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/expert_outreach

# Redis (defaults to docker-compose redis)
# REDIS_URL=redis://redis:6379/0

# API Security (defaults for local dev)
# API_KEY=dev-api-key-change-in-production
# WEBHOOK_SECRET=dev-webhook-secret-change-in-production

# LLM Model (defaults to claude-3-5-sonnet)
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Rate Limiting
# RATE_LIMIT_PER_DOMAIN_PER_HOUR=10
# RATE_LIMIT_JITTER_MIN_SECONDS=5
# RATE_LIMIT_JITTER_MAX_SECONDS=30
