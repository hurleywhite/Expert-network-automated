# Base URL for the API. Leave EMPTY in production: the frontend and the
# serverless functions are served from the same Vercel deployment, so relative
# /api/* paths resolve correctly on their own.
#
# Set this only when running `npm run dev` against a separate API host, e.g.
#   VITE_API_URL=http://localhost:3000
VITE_API_URL=

# NOTE: there are deliberately no database credentials here.
# The browser holds no database key. All reads and writes go through /api/data,
# which uses a server-only service-role key. Anything named VITE_* is compiled
# into the public JS bundle -- never put a secret in this file.
