# Security
API_KEY=your-secret-api-key-here
WEBHOOK_SECRET=your-webhook-secret-here

# Email (SendGrid)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=outreach@yourdomain.com
SENDGRID_FROM_NAME=Your Company
# Optional: For SendGrid signed webhook verification (recommended for production)
# SENDGRID_WEBHOOK_VERIFICATION_KEY=MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE...
# Optional: Domain for inbound email parsing
# SENDGRID_INBOUND_DOMAIN=parse.yourdomain.com

# LLM (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Database (use defaults for local docker-compose)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expert_outreach
# REDIS_URL=redis://localhost:6379/0

# Apollo.io (Expert Sourcing)
APOLLO_API_KEY=your_apollo_api_key_here

# Exa AI (Expert Research)
EXA_API_KEY=your_exa_api_key_here

# LinkedIn Automation
LINKEDIN_SESSION_COOKIE=your_li_at_cookie_here
LINKEDIN_DAILY_CONNECTION_LIMIT=50
LINKEDIN_DAILY_MESSAGE_LIMIT=100

# Rate Limiting
RATE_LIMIT_PER_DOMAIN_PER_HOUR=10
RATE_LIMIT_JITTER_MIN_SECONDS=5
RATE_LIMIT_JITTER_MAX_SECONDS=30
